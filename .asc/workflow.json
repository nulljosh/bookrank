// Release automation. Run: asc workflow run ship-ios VERSION:x.y.z
{
  "env": {
    "IOS_APP_ID": "6792376485",
    "VERSION": "",
    "SUBMIT": "true"
  },
  "before_all": "asc auth status",
  "workflows": {
    "ship-ios": {
      "description": "Bump, archive, upload, submit iOS",
      "steps": [
        {
          "name": "bump",
          "run": "cd ios && B=$(date +%Y%m%d%H%M) && sed -i '' -e \"s/MARKETING_VERSION: \\\"[^\\\"]*\\\"/MARKETING_VERSION: \\\"$VERSION\\\"/g\" -e \"s/CURRENT_PROJECT_VERSION: \\\"[^\\\"]*\\\"/CURRENT_PROJECT_VERSION: \\\"$B\\\"/g\" project.yml && xcodegen generate && python3 scripts/prepare-plist.py \"$B\""
        },
        {
          "name": "archive",
          "run": "cd ios && asc xcode archive --project Kernel.xcodeproj --scheme Kernel --archive-path ../.asc/artifacts/Kernel.xcarchive --overwrite --xcodebuild-flag=-skipPackagePluginValidation --xcodebuild-flag=-allowProvisioningUpdates --output json"
        },
        {
          "name": "export",
          "run": "cd ios && asc xcode export --archive-path ../.asc/artifacts/Kernel.xcarchive --export-options ExportOptions.plist --xcodebuild-flag=-allowProvisioningUpdates --overwrite --ipa-path ../.asc/artifacts/Kernel.ipa --output json"
        },
        {
          "name": "publish",
          "if": "SUBMIT",
          "run": "asc publish appstore --app $IOS_APP_ID --ipa .asc/artifacts/Kernel.ipa --version $VERSION --wait --submit --confirm --output json"
        }
      ]
    }
  }
}
