    "A chapter is about 2,500 characters. The month resets on the 1st. Chapters you already played are free to replay.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un chapitre fait environ 2 500 caractères. Le compteur se remet à zéro le 1er du mois. Les chapitres déjà écoutés sont gratuits à réécouter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un capítulo tiene unos 2.500 caracteres. El mes se reinicia el día 1. Los capítulos que ya escuchaste son gratis para volver a escucharlos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Kapitel hat etwa 2.500 Zeichen. Der Monat wird am 1. zurückgesetzt. Kapitel, die du schon gehört hast, kannst du kostenlos noch einmal abspielen."
          }
        }
      }
    },
