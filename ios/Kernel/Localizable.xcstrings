          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina tu cuenta y todos los resúmenes que contiene, de inmediato y de forma permanente. No hay forma de deshacerlo. Exporta antes si quieres una copia."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löscht dein Konto und alle Zusammenfassungen darin sofort und endgültig. Das lässt sich nicht rückgängig machen. Exportiere vorher, wenn du eine Kopie willst."
